        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Echo voegt ontbrekende nummers toe aan de downloadwachtrij. Nummers die al in je bibliotheek of wachtrij staan, worden overgeslagen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
