    "tabbarsettingsview_reorder_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "value" : "Drag the handles below to reorder. Choose the star for the tab that opens when you launch Echo.",
            "state" : "translated"
          }
        },
        "nl" : {
          "stringUnit" : {
            "value" : "Versleep de handvatten hieronder om de volgorde te wijzigen. Kies de ster bij de tab die opent wanneer je Echo start.",
            "state" : "translated"
          }
        },
        "fr" : {
          "stringUnit" : {
            "value" : "Faites glisser les poignées ci-dessous pour modifier l’ordre. Touchez l’étoile de l’onglet à afficher au lancement d’Echo.",
            "state" : "translated"
          }
        },
        "de" : {
          "stringUnit" : {
            "value" : "Ziehe die Griffe unten, um die Reihenfolge zu ändern. Wähle den Stern für den Tab, der beim Start von Echo geöffnet wird.",
            "state" : "translated"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra los controles para reordenar. Elige la estrella de la pestaña que se abre al iniciar Echo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina le maniglie per riordinare. Scegli la stella per la scheda che si apre all’avvio di Echo."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrasta as pegas para reordenar. Escolhe a estrela do separador que abre quando inicias o Echo."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przeciągnij uchwyty, aby zmienić kolejność. Wybierz gwiazdkę przy karcie, która otwiera się po uruchomieniu Echo."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sıralamak için tutamaçları sürükle. Echo’yu açtığında açılacak sekme için yıldızı seç."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下のハンドルをドラッグして並べ替えます。Echoを起動したときに開くタブには星を付けてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아래 핸들을 끌어 순서를 바꾸세요. Echo를 실행할 때 열리는 탭에 별표를 선택하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖动下方的手柄重新排序。为启动 Echo 时打开的标签选择星标。"
          }
        }
      }
    },
