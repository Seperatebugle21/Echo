    "home_customization_detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drag to reorder. Keep at least two sections; add as many available sections as you like. Changes save automatically. Empty sections appear when they have content."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versleep om de volgorde te wijzigen. Behoud minimaal twee secties; voeg zoveel beschikbare secties toe als je wilt. Wijzigingen worden automatisch bewaard. Lege secties verschijnen zodra ze inhoud hebben."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser pour réorganiser. Gardez au moins deux sections et ajoutez autant de sections disponibles que vous le souhaitez. Les modifications sont enregistrées automatiquement. Les sections vides apparaissent dès qu’elles ont du contenu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziehe die Bereiche in die gewünschte Reihenfolge. Behalte mindestens zwei Bereiche und füge beliebig viele verfügbare Bereiche hinzu. Änderungen werden automatisch gespeichert. Leere Bereiche erscheinen, sobald sie Inhalte haben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra para reordenar. Mantén al menos dos secciones; añade tantas secciones disponibles como quieras. Los cambios se guardan automáticamente. Las secciones vacías aparecen cuando tienen contenido."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina per riordinare. Mantieni almeno due sezioni; aggiungi quante sezioni disponibili vuoi. Le modifiche vengono salvate automaticamente. Le sezioni vuote compaiono quando hanno contenuti."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrasta para reordenar. Mantém pelo menos duas secções; adiciona as secções disponíveis que quiseres. As alterações são guardadas automaticamente. As secções vazias aparecem quando têm conteúdo."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przeciągnij, aby zmienić kolejność. Zostaw co najmniej dwie sekcje; dodaj dowolnie wiele dostępnych sekcji. Zmiany zapisują się automatycznie. Puste sekcje pojawią się, gdy będą miały zawartość."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sıralamak için sürükle. En az iki bölüm tut; istediğin kadar bölüm ekle. Değişiklikler otomatik kaydedilir. Boş bölümler içerik olduğunda görünür."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ドラッグして並べ替えます。セクションは2つ以上残してください。利用可能なセクションは好きなだけ追加できます。変更は自動で保存されます。空のセクションは内容があるときに表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "끌어서 순서를 바꾸세요. 섹션은 2개 이상 유지해야 하며, 사용 가능한 섹션은 원하는 만큼 추가할 수 있습니다. 변경 사항은 자동으로 저장됩니다. 빈 섹션은 내용이 생기면 표시됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖动以重新排序。至少保留两个版块；可添加任意数量的可用版块。更改会自动保存。空版块有内容后才会显示。"
          }
        }
      }
    },
