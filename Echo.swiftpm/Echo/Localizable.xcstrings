    "siri_command_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Run a short audio command in English, Dutch, French or German, independently of the app language."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voer een korte audio-opdracht uit in Nederlands, Engels, Frans of Duits, onafhankelijk van de app-taal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exécuter une commande audio courte en français, anglais, néerlandais ou allemand, indépendamment de la langue de l’app."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einen kurzen Audiobefehl auf Deutsch, Englisch, Niederländisch oder Französisch ausführen, unabhängig von der App-Sprache."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ejecuta un comando de audio corto en uno de los idiomas de Echo, independientemente del idioma de la app."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esegui un breve comando audio in una delle lingue di Echo, indipendentemente dalla lingua dell’app."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Executa um comando de áudio curto num dos idiomas do Echo, independentemente do idioma da app."
