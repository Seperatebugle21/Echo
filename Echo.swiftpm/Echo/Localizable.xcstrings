    "fetchqueueview_keep_echo_open_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd Echo open tijdens het downloaden. Downloads kunnen pauzeren of mislukken als de app wordt gesloten of je iPhone wordt vergrendeld."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep Echo open while downloading. Downloads may pause or fail if the app is closed or your iPhone is locked."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gardez Echo ouvert pendant le téléchargement. Les téléchargements peuvent être interrompus ou échouer si l’app est fermée ou si votre iPhone est verrouillé."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lass Echo während des Downloads geöffnet. Downloads können pausieren oder fehlschlagen, wenn die App geschlossen oder dein iPhone gesperrt wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén Echo abierto mientras se descarga. Las descargas pueden pausarse o fallar si cierras la app o bloqueas el iPhone."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni Echo aperto durante il download. I download possono interrompersi o non riuscire se chiudi l’app o blocchi l’iPhone."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantém o Echo aberto durante a transferência. As transferências podem parar ou falhar se fechares a app ou bloqueares o iPhone."
          }
        }
      }
