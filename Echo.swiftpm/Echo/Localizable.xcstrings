    "fetchqueueview_keep_echo_open_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je kunt naar het beginscherm gaan: Echo blijft downloaden en geeft een melding als alles klaar is. Veeg je Echo weg in de appkiezer, dan stoppen de downloads."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can go to the Home Screen: Echo keeps downloading and notifies you when everything is done. Swiping Echo away in the app switcher stops the downloads."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez revenir à l’écran d’accueil : Echo continue de télécharger et vous avertit quand tout est terminé. Fermer Echo depuis le sélecteur d’apps arrête les téléchargements."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst zum Home-Bildschirm wechseln: Echo lädt weiter und benachrichtigt dich, wenn alles fertig ist. Wenn du Echo im App-Umschalter schließt, stoppen die Downloads."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes ir a la pantalla de inicio: Echo sigue descargando y te avisa cuando todo esté listo. Si cierras Echo desde el selector de apps, las descargas se detienen."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi tornare alla schermata Home: Echo continua a scaricare e ti avvisa quando ha finito. Se chiudi Echo dal selettore app, i download si interrompono."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podes ir para o ecrã principal: o Echo continua a transferir e avisa-te quando tudo estiver concluído. Se fechares o Echo no seletor de apps, as transferências param."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Możesz przejść do ekranu głównego: Echo pobiera dalej i powiadomi Cię, gdy wszystko będzie gotowe. Zamknięcie Echo w przełączniku aplikacji zatrzymuje pobieranie."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ana ekrana geçebilirsin: Echo indirmeye devam eder ve her şey bitince bildirim gönderir. Echo’yu uygulama değiştiricide kaydırarak kapatırsan indirmeler durur."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホーム画面に移動しても、Echoはダウンロードを続け、すべて完了したら通知します。Appスイッチャーで Echo を上にスワイプして閉じると、ダウンロードは停止します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "홈 화면으로 이동해도 Echo가 계속 다운로드하고 모두 끝나면 알려 드립니다. 앱 전환기에서 Echo를 쓸어 올려 닫으면 다운로드가 중지됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你可以返回主屏幕：Echo 会继续下载，全部完成后通知你。在应用切换器中划掉 Echo 会停止下载。"
          }
        }
      }
    },
