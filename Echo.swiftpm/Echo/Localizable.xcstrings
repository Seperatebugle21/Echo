    "onboarding_spotify_body" : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spotify koppelen is volledig optioneel. Echo heeft Spotify niet nodig om te werken. Koppelen is gewoon handig om via Spotify naar nummers te zoeken en je Spotify-bibliotheek te bekijken, zodat nummers en playlists makkelijker te vinden en te downloaden zijn."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connecting Spotify is completely optional. Echo does not need Spotify to work. Connecting it is simply a convenient way to search Spotify and browse your Spotify library so songs and playlists are easier to find and download."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connecter Spotify est entièrement facultatif. Echo n’a pas besoin de Spotify pour fonctionner. La connexion permet simplement de rechercher des morceaux via Spotify et de parcourir votre bibliothèque Spotify afin de trouver et télécharger plus facilement des morceaux et playlists."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spotify zu verbinden ist vollständig optional. Echo benötigt Spotify nicht, um zu funktionieren. Die Verbindung ist lediglich praktisch, um über Spotify nach Songs zu suchen und deine Spotify-Mediathek zu durchsuchen, damit Songs und Playlists leichter gefunden und heruntergeladen werden können."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conectar Spotify es totalmente opcional. Echo no necesita Spotify para funcionar. Conectarlo es simplemente una forma cómoda de buscar en Spotify y explorar tu biblioteca para encontrar y descargar canciones y playlists con más facilidad."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Collegare Spotify è del tutto facoltativo. Echo non ha bisogno di Spotify per funzionare. Collegarlo è solo un modo comodo per cercare su Spotify e sfogliare la tua libreria Spotify, così trovi e scarichi brani e playlist più facilmente."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ligar o Spotify é totalmente opcional. O Echo não precisa do Spotify para funcionar. Ligá-lo é apenas uma forma prática de pesquisar no Spotify e explorar a tua biblioteca do Spotify, para encontrar e transferir músicas e playlists com mais facilidade."
          }
        }
      }
    },
