    "backup_restore_confirm_no_music" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This backup has no music files. Your music files stay; your library, playlists and settings are replaced. Songs whose file is not on this device are removed."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze back-up bevat geen muziekbestanden. Je muziekbestanden blijven staan; je bibliotheek, playlists en instellingen worden vervangen. Nummers waarvan het bestand niet op dit toestel staat, worden verwijderd."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette sauvegarde ne contient pas de fichiers musicaux. Vos fichiers musicaux restent ; votre bibliothèque, vos playlists et vos réglages sont remplacés. Les morceaux dont le fichier n’est pas sur cet appareil sont supprimés."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Backup enthält keine Musikdateien. Deine Musikdateien bleiben; Mediathek, Playlists und Einstellungen werden ersetzt. Songs, deren Datei nicht auf diesem Gerät ist, werden entfernt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta copia no tiene archivos de música. Tus archivos de música se mantienen; se reemplazan tu biblioteca, playlists y ajustes. Se eliminan las canciones cuyo archivo no esté en este dispositivo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo backup non contiene file musicali. I tuoi file musicali restano; libreria, playlist e impostazioni vengono sostituite. I brani il cui file non è su questo dispositivo vengono rimossi."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta cópia não tem ficheiros de música. Os teus ficheiros de música mantêm-se; a biblioteca, playlists e definições são substituídas. As músicas cujo ficheiro não está neste dispositivo são removidas."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta kopia nie zawiera plików muzycznych. Twoje pliki muzyczne zostaną; biblioteka, playlisty i ustawienia zostaną zastąpione. Utwory, których plików nie ma na tym urządzeniu, zostaną usunięte."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu yedekte müzik dosyası yok. Müzik dosyaların kalır; arşivin, çalma listelerin ve ayarların değiştirilir. Dosyası bu cihazda olmayan şarkılar kaldırılır."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このバックアップには音楽ファイルがありません。音楽ファイルはそのまま残り、ライブラリ、プレイリスト、設定が置き換えられます。このデバイスにファイルがない曲は削除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 백업에는 음악 파일이 없습니다. 음악 파일은 유지되고 보관함, 플레이리스트, 설정이 대체됩니다. 이 기기에 파일이 없는 노래는 삭제됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此备份不含音乐文件。你的音乐文件会保留；资料库、歌单和设置将被替换。此设备上没有文件的歌曲会被移除。"
          }
        }
      }
    },
