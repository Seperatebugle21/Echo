    "ai_history_detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saved locally with file protection and excluded from backups. Keeps up to 50 conversations and 200 action records. Disabling saving does not delete existing history."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lokaal opgeslagen met bestandsbeveiliging en uitgesloten van back-ups. Bewaart maximaal 50 gesprekken en 200 actieregistraties. Opslaan uitschakelen verwijdert bestaande geschiedenis niet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrées localement avec protection des fichiers et exclues des sauvegardes. Conserve jusqu’à 50 conversations et 200 actions. Désactiver l’enregistrement ne supprime pas l’historique existant."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lokal mit Dateischutz gesichert und von Backups ausgeschlossen. Bewahrt bis zu 50 Unterhaltungen und 200 Aktionen auf. Das Deaktivieren löscht den vorhandenen Verlauf nicht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se guardan localmente con protección de archivos y se excluyen de las copias de seguridad. Guarda hasta 50 conversaciones y 200 acciones. Desactivar el guardado no borra el historial existente."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salvate localmente con protezione dei file ed escluse dai backup. Conserva fino a 50 conversazioni e 200 azioni. Disattivare il salvataggio non elimina la cronologia esistente."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guardadas localmente com proteção de ficheiros e excluídas das cópias de segurança. Mantém até 50 conversas e 200 ações. Desativar não apaga o histórico existente."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapisywane lokalnie z ochroną plików i wyłączone z kopii zapasowych. Przechowuje do 50 rozmów i 200 akcji. Wyłączenie zapisu nie usuwa istniejącej historii."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dosya korumasıyla yerel olarak kaydedilir ve yedeklemelere dahil edilmez. En fazla 50 sohbet ve 200 işlem tutar. Kaydetmeyi kapatmak mevcut geçmişi silmez."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ファイル保護付きでローカルに保存され、バックアップには含まれません。最大50件の会話と200件の操作を保持します。保存をオフにしても既存の履歴は削除されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "파일 보호와 함께 로컬에 저장되며 백업에서 제외됩니다. 대화는 최대 50개, 작업 기록은 200개까지 보관합니다. 저장을 꺼도 기존 기록은 삭제되지 않습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在本地加密保存，且不包含在备份中。最多保留 50 个对话和 200 条操作记录。关闭保存不会删除已有记录。"
          }
        }
      }
    },
