        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retirer un titre le masque pendant 5 jours et remet son compteur d’écoutes à zéro uniquement pour cette playlist. Ensuite, les règles déterminent s’il revient."
          }
        },
        "de" : {
          "stringUnit" : {
