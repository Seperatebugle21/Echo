    "ai_universe_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drag to rotate, pinch to zoom, use two fingers to pan and rotate, double tap to reset."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sleep om te draaien, knijp om te zoomen, gebruik twee vingers om te verschuiven en roteren, dubbeltik om te herstellen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser pour pivoter, pincez pour zoomer, utilisez deux doigts pour déplacer et pivoter, touchez deux fois pour réinitialiser."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziehen zum Drehen, Aufziehen zum Zoomen, mit zwei Fingern verschieben und drehen, zweimal tippen zum Zurücksetzen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra para girar, pellizca para ampliar, usa dos dedos para desplazar y girar, toca dos veces para restablecer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina per ruotare, pizzica per lo zoom, usa due dita per spostare e ruotare, tocca due volte per ripristinare."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrasta para rodar, aperta para ampliar, usa dois dedos para deslocar e rodar, toca duas vezes para repor."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przeciągnij, aby obrócić, zsuń palce, aby powiększyć, użyj dwóch palców, aby przesunąć i obrócić, stuknij dwukrotnie, aby zresetować."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Döndürmek için sürükle, yakınlaştırmak için kıstır, kaydırmak ve döndürmek için iki parmak kullan, sıfırlamak için iki kez dokun."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ドラッグで回転、ピンチでズーム、2本指で移動と回転、ダブルタップでリセット。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "드래그해서 회전, 핀치로 확대/축소, 두 손가락으로 이동과 회전, 두 번 탭해서 초기화."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖动以旋转，捏合以缩放，双指平移和旋转，轻点两下重置。"
          }
        }
      }
    },
