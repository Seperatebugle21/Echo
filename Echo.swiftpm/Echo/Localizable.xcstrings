        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All saved lyrics will be deleted. The songs themselves will remain."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les paroles enregistrées seront supprimées. Les morceaux seront conservés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle gespeicherten Songtexte werden gelöscht. Die Titel selbst bleiben erhalten."
