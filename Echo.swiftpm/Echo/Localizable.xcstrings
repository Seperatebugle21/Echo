    "onboarding_learning_feature_adapts_body" : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artiesten en albums waar je graag naar luistert kunnen relevanter worden naarmate je luistergeschiedenis groeit."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artists and albums you enjoy can become more relevant as your listening history grows."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les artistes et albums que vous aimez peuvent devenir plus pertinents à mesure que votre historique grandit."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Künstler und Alben, die du magst, können mit wachsender Hörhistorie relevanter werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los artistas y álbumes que disfrutas pueden ganar relevancia a medida que crece tu historial."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
