    "settings.genius.footer" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter your Genius or Musixmatch API keys to search via these services as well. If left empty, only LRCLIB will be used to fetch lyrics."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voer je Genius- of Musixmatch-API-sleutels in om ook via deze diensten te zoeken. Als je deze leeg laat, wordt alleen LRCLIB gebruikt om songteksten op te halen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entrez vos clés d'accès API Genius ou Musixmatch pour rechercher également via ces services. Si vous laissez ces champs vides, seul LRCLIB sera utilisé pour récupérer les paroles."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geben Sie Ihre Genius- oder Musixmatch-API-Schlüssel ein, um auch über diese Dienste zu suchen. Wenn diese Felder leer bleiben, wird nur LRCLIB verwendet, um Songtexte abzurufen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Introduce tus claves de API de Genius o Musixmatch para buscar también con estos servicios. Si lo dejas vacío, solo se usará LRCLIB para obtener letras."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inserisci le chiavi API di Genius o Musixmatch per cercare anche con questi servizi. Se lasci vuoto, per i testi verrà usato solo LRCLIB."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Introduz as tuas chaves de API do Genius ou do Musixmatch para pesquisar também com estes serviços. Se ficar vazio, só o LRCLIB será usado para obter letras."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wpisz klucze API Genius lub Musixmatch, aby wyszukiwać również przez te usługi. Jeśli pozostawisz puste, teksty będą pobierane tylko z LRCLIB."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu hizmetlerle de arama yapmak için Genius veya Musixmatch API anahtarlarını gir. Boş bırakılırsa sözler yalnızca LRCLIB’den alınır."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GeniusまたはMusixmatchのAPIキーを入力すると、これらのサービスでも検索できます。空欄の場合は、歌詞の取得にLRCLIBのみを使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Genius 또는 Musixmatch API 키를 입력하면 이 서비스로도 검색합니다. 비워 두면 가사는 LRCLIB에서만 가져옵니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "输入 Genius 或 Musixmatch 的 API 密钥，以便同时通过这些服务搜索。如果留空，将仅使用 LRCLIB 获取歌词。"
          }
        }
      }
    },
