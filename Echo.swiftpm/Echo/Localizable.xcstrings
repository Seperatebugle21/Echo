    "ai_qwen_detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optional download from Hugging Face (~500 MB; allow 1.5 GB free space). Runs with MLX on a physical iPhone with at least 4 GB RAM. This small model supports chat, not app actions. Weights are loaded for each request and released afterward."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optionele download van Hugging Face (~500 MB; houd 1,5 GB vrij). Werkt via MLX op een fysieke iPhone met minstens 4 GB RAM. Dit kleine model ondersteunt chat, geen app-acties. Het model wordt per verzoek geladen en daarna vrijgegeven."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Téléchargement facultatif depuis Hugging Face (~500 Mo ; prévoyez 1,5 Go d’espace libre). Fonctionne avec MLX sur un iPhone physique avec au moins 4 Go de RAM. Ce petit modèle gère la discussion, pas les actions dans l’app. Les poids sont chargés à chaque requête puis libérés."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optionaler Download von Hugging Face (~500 MB; 1,5 GB freier Speicher empfohlen). Läuft mit MLX auf einem echten iPhone mit mindestens 4 GB RAM. Dieses kleine Modell unterstützt Chat, aber keine App-Aktionen. Die Gewichte werden für jede Anfrage geladen und danach freigegeben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descarga opcional desde Hugging Face (~500 MB; deja 1,5 GB libres). Funciona con MLX en un iPhone físico con al menos 4 GB de RAM. Este modelo pequeño admite chat, no acciones en la app. Los pesos se cargan en cada solicitud y se liberan después."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Download facoltativo da Hugging Face (~500 MB; lascia 1,5 GB liberi). Funziona con MLX su un iPhone fisico con almeno 4 GB di RAM. Questo piccolo modello supporta la chat, non le azioni nell’app. I pesi vengono caricati a ogni richiesta e poi rilasciati."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transferência opcional do Hugging Face (~500 MB; deixa 1,5 GB livres). Funciona com MLX num iPhone físico com pelo menos 4 GB de RAM. Este modelo pequeno suporta conversa, não ações na app. Os pesos são carregados em cada pedido e libertados depois."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opcjonalne pobranie z Hugging Face (~500 MB; zostaw 1,5 GB wolnego miejsca). Działa z MLX na fizycznym iPhonie z co najmniej 4 GB RAM. Ten mały model obsługuje czat, ale nie akcje w aplikacji. Wagi są ładowane przy każdym zapytaniu, a potem zwalniane."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hugging Face’ten isteğe bağlı indirme (~500 MB; 1,5 GB boş alan bırak). En az 4 GB RAM’li gerçek bir iPhone’da MLX ile çalışır. Bu küçük model sohbeti destekler, uygulama işlemlerini desteklemez. Ağırlıklar her istekte yüklenir ve ardından serbest bırakılır."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hugging Faceからの任意のダウンロード（約500 MB、1.5 GBの空き容量が必要）。RAMが4 GB以上の実機iPhoneでMLXを使って動作します。この小さなモデルはチャットに対応し、アプリ操作には対応しません。重みはリクエストごとに読み込まれ、終了後に解放されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hugging Face에서 선택적으로 다운로드(약 500MB, 여유 공간 1.5GB 필요). RAM이 4GB 이상인 실제 iPhone에서 MLX로 실행됩니다. 이 작은 모델은 채팅만 지원하며 앱 작업은 지원하지 않습니다. 가중치는 요청마다 불러온 뒤 해제됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可选择从 Hugging Face 下载（约 500 MB，需预留 1.5 GB 可用空间）。在内存至少 4 GB 的实体 iPhone 上通过 MLX 运行。这个小模型支持聊天，不支持应用操作。每次请求时加载权重，结束后释放。"
          }
        }
      }
    },
    "ai_qwen_unavailable" : {
