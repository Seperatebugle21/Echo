    "backup_create_footer_music" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saves songs, artwork, playlists, favorites, listening history, podcasts and settings, plus all music files, in one file you can store in Files or iCloud Drive. Spotify and other sign-ins are not included."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewaart nummers, covers, playlists, favorieten, luistergeschiedenis, podcasts en instellingen, plus alle muziekbestanden, in één bestand dat je in Bestanden of iCloud Drive kunt zetten. Aanmeldingen zoals Spotify gaan niet mee."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistre morceaux, pochettes, playlists, favoris, historique d’écoute, podcasts et réglages, ainsi que tous les fichiers musicaux, dans un seul fichier à placer dans Fichiers ou iCloud Drive. Les connexions comme Spotify ne sont pas incluses."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speichert Songs, Cover, Playlists, Favoriten, Hörverlauf, Podcasts und Einstellungen sowie alle Musikdateien in einer Datei für Dateien oder iCloud Drive. Anmeldungen wie Spotify sind nicht enthalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda canciones, portadas, playlists, favoritos, historial de escucha, pódcasts y ajustes, además de todos los archivos de música, en un solo archivo que puedes guardar en Archivos o iCloud Drive. No incluye Spotify ni otros inicios de sesión."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salva brani, copertine, playlist, preferiti, cronologia di ascolto, podcast e impostazioni, più tutti i file musicali, in un unico file da conservare in File o iCloud Drive. Spotify e altri accessi non sono inclusi."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda músicas, capas, playlists, favoritos, histórico de audição, podcasts e definições, além de todos os ficheiros de música, num só ficheiro que podes guardar em Ficheiros ou no iCloud Drive. O Spotify e outros inícios de sessão não estão incluídos."
          }
        }
      }
    },
    "backup_create_footer_no_music" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Without music files the backup is small, but it only works on a device that still has the same music. Songs whose file is missing are removed after restoring."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zonder muziekbestanden is de back-up klein, maar hij werkt alleen op een toestel waar dezelfde muziek nog staat. Nummers waarvan het bestand ontbreekt, worden na het terugzetten verwijderd."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sans fichiers musicaux, la sauvegarde est légère, mais ne fonctionne que sur un appareil qui contient encore la même musique. Les morceaux dont le fichier manque sont supprimés après la restauration."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohne Musikdateien ist das Backup klein, funktioniert aber nur auf einem Gerät, das dieselbe Musik noch hat. Songs ohne Datei werden nach der Wiederherstellung entfernt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin archivos de música la copia es pequeña, pero solo funciona en un dispositivo que todavía tenga la misma música. Las canciones cuyo archivo falte se eliminan tras restaurar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senza file musicali il backup è piccolo, ma funziona solo su un dispositivo che ha ancora la stessa musica. I brani il cui file manca vengono rimossi dopo il ripristino."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem ficheiros de música a cópia é pequena, mas só funciona num dispositivo que ainda tenha a mesma música. As músicas cujo ficheiro falte são removidas após o restauro."
          }
        }
      }
    },
