    "smart_remove_detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Removing a song hides it for 5 days and resets its playcount only for this playlist. After that, the rules decide whether it returns."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een nummer verwijderen verbergt het 5 dagen en reset de playcount alleen voor deze playlist. Daarna bepalen de regels of het terugkomt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retirer un titre le masque pendant 5 jours et remet son compteur d’écoutes à zéro uniquement pour cette playlist. Ensuite, les règles déterminent s’il revient."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Entfernen eines Titels blendet ihn 5 Tage lang aus und setzt seine Wiedergabezahl nur für diese Playlist zurück. Danach entscheiden die Regeln, ob er zurückkehrt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quitar una canción la oculta 5 días y reinicia su recuento de reproducciones solo en esta playlist. Después, las reglas deciden si vuelve."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rimuovere un brano lo nasconde per 5 giorni e azzera il conteggio degli ascolti solo per questa playlist. Poi sono le regole a decidere se torna."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remover uma música oculta-a durante 5 dias e repõe a contagem de reproduções só nesta playlist. Depois, as regras decidem se volta."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usunięcie utworu ukrywa go na 5 dni i zeruje liczbę odtworzeń tylko w tej playliście. Potem reguły decydują, czy wróci."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir şarkıyı kaldırmak onu 5 gün gizler ve yalnızca bu çalma listesindeki çalınma sayısını sıfırlar. Sonrasında geri gelip gelmeyeceğine kurallar karar verir."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "曲を削除すると5日間非表示になり、このプレイリストでの再生回数だけがリセットされます。その後、戻すかどうかはルールで決まります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "노래를 삭제하면 5일 동안 숨겨지고 이 플레이리스트의 재생 횟수만 초기화됩니다. 그 후 다시 포함될지는 규칙이 결정합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移除歌曲会将其隐藏 5 天，并仅在此歌单中重置播放次数。之后由规则决定是否重新加入。"
          }
        }
      }
    },
