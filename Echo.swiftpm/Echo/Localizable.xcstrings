    "onboarding_welcome_subtitle" : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je muziek, je bibliotheek en je luisterervaring — samengebracht op één plek."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your music, your library and your listening experience — brought together in one place."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre musique, votre bibliothèque et votre expérience d’écoute — réunies au même endroit."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Musik, deine Mediathek und dein Hörerlebnis — an einem Ort vereint."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu música, tu biblioteca y tu forma de escuchar, reunidas en un solo lugar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua musica, la tua libreria e il tuo modo di ascoltare, riuniti in un unico posto."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A tua música, a tua biblioteca e a tua forma de ouvir, reunidas num só lugar."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoja muzyka, biblioteka i sposób słuchania — wszystko w jednym miejscu."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Müziğin, arşivin ve dinleme deneyimin — hepsi tek bir yerde."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたの音楽、ライブラリ、リスニング体験を、ひとつの場所に。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
