    "ai_voice_detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With Offline Only disabled, Apple speech recognition may send microphone audio to Apple. Your spoken question is sent automatically after a brief pause."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als Alleen offline uitstaat, kan Apple spraakherkenning microfoonaudio naar Apple sturen. Je gesproken vraag wordt automatisch verstuurd na een korte pauze."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si « Hors ligne uniquement » est désactivé, la reconnaissance vocale d’Apple peut envoyer l’audio du micro à Apple. Votre question est envoyée automatiquement après une courte pause."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn „Nur offline“ deaktiviert ist, kann die Spracherkennung von Apple Mikrofonaudio an Apple senden. Deine gesprochene Frage wird nach einer kurzen Pause automatisch gesendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con «Solo sin conexión» desactivado, el reconocimiento de voz de Apple puede enviar el audio del micrófono a Apple. Tu pregunta se envía automáticamente tras una breve pausa."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con «Solo offline» disattivato, il riconoscimento vocale di Apple può inviare l’audio del microfono ad Apple. La tua domanda viene inviata automaticamente dopo una breve pausa."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com «Apenas offline» desativado, o reconhecimento de voz da Apple pode enviar o áudio do microfone para a Apple. A tua pergunta é enviada automaticamente após uma breve pausa."
          }
        }
      }
    },
