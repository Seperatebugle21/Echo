    "ai_permissions_detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Full App Control only authorizes registered Echo actions. Playlist deletion always asks. The assistant cannot change these permissions, credentials or security settings."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volledige appbediening geldt alleen voor geregistreerde Echo-acties. Afspeellijsten verwijderen vereist altijd bevestiging. De assistent kan deze machtigingen, sleutels of beveiligingsinstellingen niet wijzigen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le contrôle total n’autorise que les actions Echo enregistrées. La suppression d’une playlist demande toujours confirmation. L’assistant ne peut pas modifier ces autorisations, identifiants ou réglages de sécurité."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volle App-Steuerung erlaubt nur registrierte Echo-Aktionen. Beim Löschen einer Playlist wird immer gefragt. Der Assistent kann diese Berechtigungen, Zugangsdaten und Sicherheitseinstellungen nicht ändern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El control total solo autoriza acciones registradas de Echo. Eliminar una playlist siempre pide confirmación. El asistente no puede cambiar estos permisos, credenciales ni ajustes de seguridad."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il controllo completo autorizza solo le azioni Echo registrate. L’eliminazione di una playlist chiede sempre conferma. L’assistente non può modificare queste autorizzazioni, credenziali o impostazioni di sicurezza."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O controlo total só autoriza ações registadas do Echo. Eliminar uma playlist pede sempre confirmação. O assistente não pode alterar estas permissões, credenciais ou definições de segurança."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pełna kontrola pozwala tylko na zarejestrowane akcje Echo. Usunięcie playlisty zawsze wymaga potwierdzenia. Asystent nie może zmieniać tych uprawnień, danych logowania ani ustawień bezpieczeństwa."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tam kontrol yalnızca kayıtlı Echo işlemlerine izin verir. Çalma listesi silme her zaman onay ister. Asistan bu izinleri, kimlik bilgilerini veya güvenlik ayarlarını değiştiremez."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "完全な操作で許可されるのは登録済みのEcho操作のみです。プレイリストの削除は常に確認されます。アシスタントはこれらの権限、認証情報、セキュリティ設定を変更できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱 전체 제어는 등록된 Echo 작업만 허용합니다. 플레이리스트 삭제는 항상 확인합니다. 어시스턴트는 이 권한, 자격 증명, 보안 설정을 변경할 수 없습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "完全控制仅授权已注册的 Echo 操作。删除歌单始终需要确认。助手无法更改这些权限、凭据或安全设置。"
          }
        }
      }
    },
