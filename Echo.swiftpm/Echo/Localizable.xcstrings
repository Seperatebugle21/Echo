    "theme_separate_palettes_detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When enabled, Custom follows the iOS light or dark mode. Change the colors for the active mode. When disabled, one Custom palette is used in both modes."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als dit aanstaat, volgt Aangepast de lichte of donkere iOS-modus. Je wijzigt de kleuren voor de actieve modus. Als dit uitstaat, wordt één aangepast palet in beide modi gebruikt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsque cette option est activée, Personnalisé suit le mode clair ou sombre d’iOS. Modifiez les couleurs du mode actif. Sinon, une seule palette personnalisée est utilisée dans les deux modes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn aktiviert, folgt Benutzerdefiniert dem hellen oder dunklen iOS-Modus. Du bearbeitest die Farben des aktiven Modus. Wenn deaktiviert, wird in beiden Modi dieselbe Palette verwendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si está activado, Personalizado sigue el modo claro u oscuro de iOS. Cambia los colores del modo activo. Si está desactivado, se usa una sola paleta en ambos modos."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se attivo, Personalizzato segue la modalità chiara o scura di iOS. Modifica i colori della modalità attiva. Se disattivo, viene usata una sola palette in entrambe le modalità."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando ativado, Personalizado segue o modo claro ou escuro do iOS. Altera as cores do modo ativo. Quando desativado, é usada uma só paleta nos dois modos."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy włączone, Własny motyw podąża za trybem jasnym lub ciemnym iOS. Zmień kolory aktywnego trybu. Gdy wyłączone, w obu trybach używana jest jedna paleta."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Açıkken Özel, iOS’un açık veya koyu moduna uyar. Etkin modun renklerini değiştir. Kapalıyken her iki modda tek bir palet kullanılır."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オンにすると、カスタムはiOSのライト/ダークモードに従います。現在のモードの色を変更します。オフにすると、両方のモードで1つのパレットを使います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "켜면 사용자 지정이 iOS의 라이트 또는 다크 모드를 따릅니다. 현재 모드의 색상을 변경하세요. 끄면 두 모드에서 하나의 팔레트를 사용합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开启后，“自定义”会跟随 iOS 的浅色或深色模式。更改当前模式的颜色。关闭后，两种模式使用同一套配色。"
          }
        }
      }
    },
