    "lyrics_fetch_failed" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No matching lyrics could be retrieved. Check your connection and service credentials, or try another source. Existing lyrics have been kept."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er konden geen passende lyrics worden opgehaald. Controleer je verbinding en API-sleutels of probeer een andere bron. Bestaande lyrics zijn behouden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune parole correspondante n’a pu être récupérée. Vérifiez votre connexion et vos clés API, ou essayez une autre source. Les paroles existantes sont conservées."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es konnte kein passender Songtext abgerufen werden. Prüfe deine Verbindung und API-Schlüssel oder versuche eine andere Quelle. Vorhandene Songtexte bleiben erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido obtener ninguna letra coincidente. Revisa tu conexión y las credenciales del servicio, o prueba otra fuente. Se ha conservado la letra existente."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile recuperare un testo corrispondente. Controlla la connessione e le credenziali del servizio, o prova un’altra fonte. Il testo esistente è stato mantenuto."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível obter uma letra correspondente. Verifica a ligação e as credenciais do serviço, ou experimenta outra fonte. A letra existente foi mantida."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się pobrać pasującego tekstu. Sprawdź połączenie i dane logowania usługi lub spróbuj innego źródła. Istniejący tekst został zachowany."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eşleşen şarkı sözü alınamadı. Bağlantını ve hizmet kimlik bilgilerini kontrol et ya da başka bir kaynak dene. Mevcut sözler korundu."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一致する歌詞を取得できませんでした。接続とサービスの認証情報を確認するか、別のソースを試してください。既存の歌詞はそのまま残っています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일치하는 가사를 가져오지 못했습니다. 연결 상태와 서비스 자격 증명을 확인하거나 다른 소스를 사용해 보세요. 기존 가사는 유지되었습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法获取匹配的歌词。请检查网络连接和服务凭据，或尝试其他来源。现有歌词已保留。"
          }
        }
      }
    },
