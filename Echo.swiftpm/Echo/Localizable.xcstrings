    "smart_manual_detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manually added songs stay included regardless of the rules and do not count toward the automatic limit. Removed songs cannot be added again for 5 days."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Handmatig toegevoegde nummers blijven erin ongeacht de regels en tellen niet mee voor de automatische limiet. Verwijderde nummers kunnen 5 dagen lang niet opnieuw worden toegevoegd."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les titres ajoutés manuellement restent inclus quelles que soient les règles et ne comptent pas dans la limite automatique. Les titres retirés ne peuvent pas être ajoutés à nouveau pendant 5 jours."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manuell hinzugefügte Titel bleiben unabhängig von den Regeln enthalten und zählen nicht zur automatischen Begrenzung. Entfernte Titel können 5 Tage lang nicht erneut hinzugefügt werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las canciones añadidas manualmente se mantienen sin importar las reglas y no cuentan para el límite automático. Las canciones quitadas no se pueden volver a añadir durante 5 días."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I brani aggiunti manualmente restano inclusi a prescindere dalle regole e non contano per il limite automatico. I brani rimossi non possono essere riaggiunti per 5 giorni."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As músicas adicionadas manualmente ficam incluídas independentemente das regras e não contam para o limite automático. As músicas removidas não podem ser adicionadas de novo durante 5 dias."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ręcznie dodane utwory pozostają na liście niezależnie od reguł i nie wliczają się do limitu automatycznego. Usuniętych utworów nie można ponownie dodać przez 5 dni."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle eklenen şarkılar kurallardan bağımsız olarak listede kalır ve otomatik limite sayılmaz. Kaldırılan şarkılar 5 gün boyunca yeniden eklenemez."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手動で追加した曲はルールに関係なく含まれ、自動の上限には数えられません。削除した曲は5日間再追加できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "직접 추가한 노래는 규칙과 관계없이 포함되며 자동 한도에 포함되지 않습니다. 삭제한 노래는 5일 동안 다시 추가할 수 없습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手动添加的歌曲始终保留，不受规则影响，也不计入自动上限。移除的歌曲在 5 天内无法再次添加。"
          }
        }
      }
    },
