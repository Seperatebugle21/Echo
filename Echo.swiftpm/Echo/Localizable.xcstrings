            "value" : "Przeciągnij sekcje na miejsce. Dodaj coś nowego lub usuń to, czego nie potrzebujesz."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bölümleri aşağıda yerlerine sürükle. Yeni bir şey ekle veya ihtiyacın olmayanı kaldır."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下のセクションをドラッグして配置します。新しいものを追加したり、不要なものを削除したりできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아래에서 섹션을 끌어 배치하세요. 새 섹션을 추가하거나 필요 없는 섹션을 삭제할 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在下方拖动版块调整位置。添加新内容，或移除不需要的部分。"
          }
        }
      }
    },
