    "ai_check_detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tests the key shown above with a short prompt. Tap Save Key to use it in conversations. Your provider may charge for this request. Models must support Chat Completions streaming and function tools for app control."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Test de sleutel hierboven met een korte vraag. Tik op Sleutel opslaan om hem in gesprekken te gebruiken. Je provider kan dit verzoek aanrekenen. Modellen moeten Chat Completions-streaming en functies ondersteunen voor appbediening."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teste la clé ci-dessus avec une courte requête. Touchez Enregistrer la clé pour l’utiliser dans les conversations. Votre fournisseur peut facturer cette requête. Les modèles doivent prendre en charge le streaming Chat Completions et les outils de fonction pour contrôler l’app."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Testet den oben angezeigten Schlüssel mit einer kurzen Anfrage. Tippe auf „Schlüssel speichern“, um ihn in Unterhaltungen zu verwenden. Dein Anbieter kann diese Anfrage berechnen. Modelle müssen Chat-Completions-Streaming und Funktionstools zur App-Steuerung unterstützen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prueba la clave mostrada arriba con una solicitud corta. Toca Guardar clave para usarla en las conversaciones. Tu proveedor puede cobrar por esta solicitud. Los modelos deben admitir streaming de Chat Completions y herramientas de funciones para controlar la app."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prova la chiave mostrata sopra con una breve richiesta. Tocca Salva chiave per usarla nelle conversazioni. Il fornitore potrebbe addebitare questa richiesta. I modelli devono supportare lo streaming Chat Completions e gli strumenti di funzione per controllare l’app."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Testa a chave acima com um pedido curto. Toca em Guardar chave para a usar nas conversas. O fornecedor pode cobrar este pedido. Os modelos têm de suportar streaming de Chat Completions e ferramentas de funções para controlar a app."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Testuje powyższy klucz krótkim zapytaniem. Stuknij Zapisz klucz, aby używać go w rozmowach. Dostawca może pobrać opłatę za to zapytanie. Modele muszą obsługiwać streaming Chat Completions i narzędzia funkcji do sterowania aplikacją."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yukarıdaki anahtarı kısa bir istekle test eder. Sohbetlerde kullanmak için Anahtarı Kaydet’e dokun. Sağlayıcın bu istek için ücret alabilir. Uygulamayı kontrol etmek için modeller Chat Completions akışını ve fonksiyon araçlarını desteklemelidir."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上に表示されたキーを短いリクエストでテストします。会話で使うには「キーを保存」をタップしてください。このリクエストはプロバイダによって課金される場合があります。アプリ操作には、Chat Completionsのストリーミングと関数ツールに対応したモデルが必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "위의 키를 짧은 요청으로 테스트합니다. 대화에서 사용하려면 ‘키 저장’을 탭하세요. 제공업체가 이 요청에 요금을 부과할 수 있습니다. 앱을 제어하려면 모델이 Chat Completions 스트리밍과 함수 도구를 지원해야 합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用一个简短请求测试上方的密钥。轻点“保存密钥”即可在对话中使用。服务商可能会对此请求收费。模型必须支持 Chat Completions 流式输出和函数工具才能控制应用。"
          }
        }
      }
    },
