    "ai_motion_detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respects Reduce Motion. Frame rate and resolution decrease in Low Power Mode or when the device is hot."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respecteert Verminder beweging. Beeldsnelheid en resolutie dalen bij energiebesparing of een warm apparaat."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respecte « Réduire les animations ». La fréquence d’images et la résolution baissent en mode Économie d’énergie ou quand l’appareil chauffe."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berücksichtigt „Bewegung reduzieren“. Bildrate und Auflösung sinken im Stromsparmodus oder wenn das Gerät warm ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respeta «Reducir movimiento». La frecuencia de fotogramas y la resolución bajan en modo de bajo consumo o cuando el dispositivo está caliente."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rispetta «Riduci movimento». Frequenza fotogrammi e risoluzione diminuiscono in modalità risparmio energetico o quando il dispositivo è caldo."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respeita «Reduzir movimento». A taxa de fotogramas e a resolução diminuem no modo de baixo consumo ou quando o dispositivo está quente."
          }
        }
      }
    },
