    "onboarding_learning_feature_adapts_body" : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artiesten en albums waar je graag naar luistert kunnen relevanter worden naarmate je luistergeschiedenis groeit."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artists and albums you enjoy can become more relevant as your listening history grows."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les artistes et albums que vous aimez peuvent devenir plus pertinents à mesure que votre historique grandit."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Künstler und Alben, die du magst, können mit wachsender Hörhistorie relevanter werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los artistas y álbumes que disfrutas pueden ganar relevancia a medida que crece tu historial."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli artisti e gli album che ami possono diventare più rilevanti man mano che la cronologia cresce."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os artistas e álbuns de que gostas podem ganhar relevância à medida que o teu histórico cresce."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lubiani wykonawcy i albumy mogą zyskiwać na znaczeniu wraz z rosnącą historią słuchania."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dinleme geçmişin büyüdükçe sevdiğin sanatçılar ve albümler öne çıkabilir."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再生履歴が増えるにつれて、好きなアーティストやアルバムがより反映されるようになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "감상 기록이 쌓일수록 좋아하는 아티스트와 앨범이 더 많이 반영될 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "随着聆听记录增长，你喜欢的艺人和专辑会变得更加突出。"
          }
        }
      }
    },
    "onboarding_learning_feature_discovery_title" : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laat ruimte om te ontdekken"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Still leaves room to discover"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Garde une place pour la découverte"
          }
        },
        "de" : {
          "stringUnit" : {
