    "widget_not_connected_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Echo and this widget cannot share music data. Reinstall Echo with its widget extension, then open the app."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Echo en deze widget kunnen geen muziekgegevens delen. Installeer Echo opnieuw met de widgetextensie en open daarna de app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Echo et ce widget ne peuvent pas partager les données musicales. Réinstallez Echo avec son extension de widget, puis ouvrez l’app."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Echo und dieses Widget können keine Musikdaten teilen. Installiere Echo mit der Widget-Erweiterung neu und öffne dann die App."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Echo y este widget no pueden compartir datos de música. Vuelve a instalar Echo con su extensión de widget y luego abre la app."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Echo e questo widget non possono condividere i dati musicali. Reinstalla Echo con la sua estensione widget, poi apri l’app."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Echo e este widget não conseguem partilhar dados de música. Reinstala o Echo com a extensão de widget e depois abre a app."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Echo i ten widżet nie mogą udostępniać danych muzycznych. Zainstaluj ponownie Echo z rozszerzeniem widżetu, a następnie otwórz aplikację."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Echo ve bu widget müzik verilerini paylaşamıyor. Echo’yu widget uzantısıyla yeniden yükle, ardından uygulamayı aç."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Echoとこのウィジェットで音楽データを共有できません。ウィジェット拡張機能を含めてEchoを再インストールし、アプリを開いてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Echo와 이 위젯이 음악 데이터를 공유할 수 없습니다. 위젯 확장 프로그램과 함께 Echo를 다시 설치한 다음 앱을 여세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Echo 与此小组件无法共享音乐数据。请重新安装包含小组件扩展的 Echo，然后打开应用。"
          }
        }
      }
    },
