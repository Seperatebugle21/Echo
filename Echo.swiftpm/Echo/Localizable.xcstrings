    "siri_command_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Run a short audio command in one of Echo’s languages, independently of the app language."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voer een korte audio-opdracht uit in een van de talen van Echo, los van de taal van de app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exécutez une courte commande audio dans l’une des langues d’Echo, indépendamment de la langue de l’app."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Führe einen kurzen Audiobefehl in einer der Sprachen von Echo aus, unabhängig von der App-Sprache."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ejecuta un comando de audio corto en uno de los idiomas de Echo, independientemente del idioma de la app."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esegui un breve comando audio in una delle lingue di Echo, indipendentemente dalla lingua dell’app."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Executa um comando de áudio curto num dos idiomas do Echo, independentemente do idioma da app."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wykonaj krótkie polecenie audio w jednym z języków Echo, niezależnie od języka aplikacji."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulama dilinden bağımsız olarak Echo’nun dillerinden birinde kısa bir ses komutu çalıştır."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリの言語に関係なく、Echoが対応する言語で短いオーディオコマンドを実行します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱 언어와 관계없이 Echo가 지원하는 언어로 짧은 오디오 명령을 실행합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 Echo 支持的任一语言执行简短的音频指令，不受应用语言影响。"
          }
        }
      }
    },
