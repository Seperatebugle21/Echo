    "equalizerview_headroom_hint" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "value" : "Boosting frequencies can lower the overall volume to leave room for the extra gain. The equalizer affects music played by Echo.",
            "state" : "translated"
          }
        },
        "nl" : {
          "stringUnit" : {
            "value" : "Bij het versterken van frequenties kan het totale volume dalen om ruimte te laten voor de versterking. De equalizer werkt op muziek die Echo afspeelt.",
            "state" : "translated"
          }
        },
        "fr" : {
          "stringUnit" : {
            "value" : "L’amplification de certaines fréquences peut réduire le volume global afin de laisser une marge au gain supplémentaire. L’égaliseur agit sur la musique lue par Echo.",
            "state" : "translated"
          }
        },
        "de" : {
          "stringUnit" : {
            "value" : "Beim Anheben von Frequenzen kann die Gesamtlautstärke sinken, um Platz für die zusätzliche Verstärkung zu lassen. Der Equalizer wirkt auf Musik, die Echo abspielt.",
            "state" : "translated"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Realzar frecuencias puede bajar el volumen general para dejar margen a la ganancia extra. El ecualizador afecta a la música reproducida por Echo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aumentare le frequenze può abbassare il volume complessivo per lasciare spazio al guadagno extra. L’equalizzatore agisce sulla musica riprodotta da Echo."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Realçar frequências pode baixar o volume geral para dar espaço ao ganho extra. O equalizador afeta a música reproduzida pelo Echo."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podbijanie częstotliwości może obniżyć ogólną głośność, by zostawić miejsce na dodatkowe wzmocnienie. Korektor działa na muzykę odtwarzaną przez Echo."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frekansları yükseltmek, ek kazanca yer açmak için genel ses düzeyini düşürebilir. Ekolayzır, Echo’nun çaldığı müziği etkiler."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "周波数を持ち上げると、余分なゲインのために全体の音量が下がることがあります。イコライザはEchoで再生する音楽に適用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "주파수를 높이면 추가 게인을 위한 여유를 두기 위해 전체 볼륨이 낮아질 수 있습니다. 이퀄라이저는 Echo에서 재생하는 음악에 적용됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
