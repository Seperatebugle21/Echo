    "fetchurlviews_transfer_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Echo übernimmt Name und Cover, fügt vorhandene Titel sofort hinzu und lädt nur fehlende Titel herunter."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Echo copies the name and cover, adds existing songs immediately, and downloads only missing songs."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Echo copie le nom et la pochette, ajoute immédiatement les morceaux existants et télécharge uniquement les morceaux manquants."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Echo neemt de naam en cover over, voegt bestaande nummers meteen toe en downloadt alleen de ontbrekende nummers."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Echo copia el nombre y la portada, añade al instante las canciones existentes y solo descarga las que faltan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Echo copia il nome e la copertina, aggiunge subito i brani esistenti e scarica solo quelli mancanti."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Echo copia o nome e a capa, adiciona de imediato as músicas existentes e só transfere as que faltam."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Echo kopiuje nazwę i okładkę, od razu dodaje istniejące utwory i pobiera tylko brakujące."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Echo adı ve kapağı kopyalar, mevcut şarkıları hemen ekler ve yalnızca eksik şarkıları indirir."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Echoは名前とカバーをコピーし、既存の曲をすぐに追加して、不足している曲だけをダウンロードします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Echo는 이름과 커버를 복사하고, 기존 노래를 바로 추가하며, 없는 노래만 다운로드합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Echo 会复制名称和封面，立即添加已有歌曲，并只下载缺少的歌曲。"
          }
        }
      }
    },
