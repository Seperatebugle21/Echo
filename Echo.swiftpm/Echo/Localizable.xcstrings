        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱 배경이 외관에 맞춰 어둡거나 밝은, 커버 색상의 부드러운 그라데이션으로 바뀝니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
