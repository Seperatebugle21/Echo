    "onboarding_library_feature_songs_body" : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geïmporteerde en gedownloade nummers staan samen, zodat je collectie eenvoudig te beheren blijft."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imported and downloaded songs appear together so your collection stays simple to manage."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les morceaux importés et téléchargés apparaissent ensemble pour garder votre collection facile à gérer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importierte und heruntergeladene Songs erscheinen zusammen, damit deine Sammlung einfach zu verwalten bleibt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las canciones importadas y descargadas aparecen juntas para que tu colección sea fácil de gestionar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I brani importati e scaricati compaiono insieme, così la tua collezione resta semplice da gestire."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As músicas importadas e transferidas aparecem juntas, para que a tua coleção seja simples de gerir."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaimportowane i pobrane utwory są widoczne razem, więc kolekcją łatwo zarządzać."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İçe aktarılan ve indirilen şarkılar bir arada görünür, böylece koleksiyonunu yönetmek kolay olur."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "読み込んだ曲もダウンロードした曲も一緒に表示されるので、コレクションを簡単に管理できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가져온 노래와 다운로드한 노래가 함께 표시되어 컬렉션을 쉽게 관리할 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "导入和下载的歌曲一起显示，让你的收藏易于管理。"
          }
        }
      }
    },
