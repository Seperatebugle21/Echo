    "album_completion_add_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Existing songs are added to this album without downloading another copy. Missing or queued songs are added when their downloads finish. Each song appears only once in this album."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bestaande nummers worden aan dit album toegevoegd zonder een extra kopie te downloaden. Ontbrekende of ingeplande nummers worden toegevoegd zodra de download klaar is. Elk nummer staat maar één keer in dit album."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les titres existants sont ajoutés à cet album sans télécharger une autre copie. Les titres manquants ou en attente sont ajoutés une fois leur téléchargement terminé. Chaque titre n’apparaît qu’une fois dans cet album."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vorhandene Songs werden diesem Album ohne erneuten Download hinzugefügt. Fehlende oder vorgemerkte Songs werden nach dem Download hinzugefügt. Jeder Song erscheint nur einmal in diesem Album."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las canciones existentes se añaden a este álbum sin descargar otra copia. Las que faltan o están en cola se añaden cuando terminan de descargarse. Cada canción aparece solo una vez en este álbum."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I brani esistenti vengono aggiunti a questo album senza scaricarne un’altra copia. I brani mancanti o in coda vengono aggiunti al termine del download. Ogni brano compare una sola volta in questo album."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As músicas existentes são adicionadas a este álbum sem transferir outra cópia. As que faltam ou estão em fila são adicionadas quando a transferência terminar. Cada música aparece só uma vez neste álbum."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Istniejące utwory są dodawane do tego albumu bez pobierania kolejnej kopii. Brakujące lub oczekujące utwory zostaną dodane po zakończeniu pobierania. Każdy utwór pojawia się w albumie tylko raz."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mevcut şarkılar başka bir kopya indirilmeden bu albüme eklenir. Eksik veya sıradaki şarkılar indirme bittiğinde eklenir. Her şarkı bu albümde yalnızca bir kez görünür."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "既存の曲は、新たにダウンロードせずにこのアルバムに追加されます。不足している曲やキュー内の曲は、ダウンロード完了時に追加されます。各曲はこのアルバムに1回だけ表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기존 노래는 다시 다운로드하지 않고 이 앨범에 추가됩니다. 없는 노래나 대기 중인 노래는 다운로드가 끝나면 추가됩니다. 각 노래는 이 앨범에 한 번만 표시됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已有的歌曲会直接添加到此专辑，不会再下载一份。缺少或排队中的歌曲会在下载完成后添加。每首歌在此专辑中只出现一次。"
          }
        }
      }
    },
