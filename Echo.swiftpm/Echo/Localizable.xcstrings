    "spotifyplaylistdetailview_transfer_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Echo neemt de naam en cover over, voegt bestaande nummers meteen toe en downloadt alleen de ontbrekende nummers."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Echo copies the name and cover, adds existing songs immediately, and downloads only missing songs."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Echo copie le nom et la couverture, ajoute immédiatement les morceaux existants et ne télécharge que les morceaux manquants."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Echo übernimmt Namen und Cover, fügt vorhandene Titel sofort hinzu und lädt nur fehlende Titel herunter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Echo copia el nombre y la portada, añade al instante las canciones existentes y solo descarga las que faltan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Echo copia il nome e la copertina, aggiunge subito i brani esistenti e scarica solo quelli mancanti."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Echo copia o nome e a capa, adiciona de imediato as músicas existentes e só transfere as que faltam."
          }
        }
      }
    },
