    "onboarding_fetch_feature_download_body" : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Echo bereidt het gekozen nummer voor en gebruikt de yt-dlp-downloadflow om de audio op te halen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Echo prepares the selected track and uses its yt-dlp download flow to retrieve the audio."
          }
