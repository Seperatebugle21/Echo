    "lyrics_wifi_needed_description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für diesen Titel sind noch keine Songtexte gespeichert. Verbinde dich mit dem Internet, um sie abzurufen. Falls du mit dem Internet verbunden bist, versuche das Lied neu zu starten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No lyrics are saved for this song yet. Connect to the internet to retrieve lyrics. If you are already connected to Wi-Fi or cellular data, try restarting the song."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune parole n'est encore enregistrée pour ce morceau. Connectez-vous à Internet pour les récupérer. Si vous êtes déjà connecté au Wi-Fi ou aux données mobiles, essayez de relancer le morceau."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er zijn nog geen lyrics opgeslagen voor dit nummer. Verbind met internet om de lyrics op te halen. Als je toch verbonden bent met wifi of mobiele data, probeer dan het lied te herstarten."
          }
        }
      }
    },
