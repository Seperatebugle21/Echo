    "onboarding_learning_feature_discovery_body" : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aanbevelingen herhalen niet alleen je favorieten — Echo geeft ook minder beluisterde nummers een kans."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recommendations do not only repeat favourites — Echo also gives less-played songs a chance."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les recommandations ne répètent pas seulement vos favoris — Echo donne aussi une chance aux morceaux moins écoutés."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empfehlungen wiederholen nicht nur Favoriten — Echo gibt auch seltener gehörten Songs eine Chance."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las recomendaciones no solo repiten favoritos: Echo también da una oportunidad a canciones menos escuchadas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I consigli non ripetono solo i preferiti: Echo dà una possibilità anche ai brani meno ascoltati."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As recomendações não repetem só favoritos: o Echo também dá uma oportunidade a músicas menos ouvidas."
          }
        }
      }
    },
