    "onboarding_library_feature_metadata_body" : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Titels, artiesten, albums en artwork zorgen dat elk nummer netjes in je bibliotheek past."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Titles, artists, albums and artwork help every song feel at home in your library."
          }
