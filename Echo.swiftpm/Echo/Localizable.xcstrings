    "ai_cloud_detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The selected provider receives your conversation context and focused tool results, such as requested song metadata. No audio files or full library are uploaded. Automatic can use OpenAI only when configured and allowed."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De geselecteerde provider ontvangt gesprekscontext en gerichte actieresultaten, zoals opgevraagde metadata. Audiobestanden en de volledige bibliotheek worden niet geüpload. Automatisch kan OpenAI alleen gebruiken als dit ingesteld en toegestaan is."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fournisseur choisi reçoit le contexte de votre conversation et des résultats d’outils ciblés, comme les métadonnées des morceaux demandés. Aucun fichier audio ni la bibliothèque complète ne sont envoyés. Le mode automatique n’utilise OpenAI que s’il est configuré et autorisé."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der gewählte Anbieter erhält den Kontext deiner Unterhaltung und gezielte Tool-Ergebnisse, etwa Metadaten angefragter Titel. Es werden keine Audiodateien und nicht die ganze Mediathek hochgeladen. Automatisch nutzt OpenAI nur, wenn es eingerichtet und erlaubt ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El proveedor elegido recibe el contexto de tu conversación y resultados concretos de herramientas, como los metadatos de las canciones solicitadas. No se suben archivos de audio ni la biblioteca completa. El modo automático solo usa OpenAI si está configurado y permitido."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il fornitore scelto riceve il contesto della conversazione e risultati mirati degli strumenti, come i metadati dei brani richiesti. Non vengono caricati file audio né l’intera libreria. La modalità automatica usa OpenAI solo se configurato e consentito."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O fornecedor escolhido recebe o contexto da conversa e resultados específicos de ferramentas, como metadados das músicas pedidas. Não são enviados ficheiros de áudio nem a biblioteca completa. O modo automático só usa a OpenAI se estiver configurada e permitida."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybrany dostawca otrzymuje kontekst rozmowy i wybrane wyniki narzędzi, np. metadane żądanych utworów. Nie są wysyłane pliki audio ani cała biblioteka. Tryb automatyczny korzysta z OpenAI tylko wtedy, gdy jest skonfigurowane i dozwolone."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seçilen sağlayıcı sohbet bağlamını ve istenen şarkı bilgileri gibi hedefli araç sonuçlarını alır. Ses dosyaları veya arşivin tamamı yüklenmez. Otomatik mod OpenAI’yi yalnızca yapılandırılmış ve izin verilmişse kullanır."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択したプロバイダは、会話の文脈と、リクエストされた曲のメタデータなど必要なツール結果を受け取ります。オーディオファイルやライブラリ全体はアップロードされません。自動モードでは、設定・許可されている場合にのみOpenAIを使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택한 제공업체는 대화 맥락과 요청한 노래의 메타데이터 같은 필요한 도구 결과를 받습니다. 오디오 파일이나 전체 보관함은 업로드되지 않습니다. 자동 모드는 설정되고 허용된 경우에만 OpenAI를 사용합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所选服务商会收到你的对话上下文和有针对性的工具结果，例如所请求歌曲的元数据。不会上传音频文件或整个资料库。仅在已配置并允许时，自动模式才会使用 OpenAI。"
          }
        }
      }
    },
