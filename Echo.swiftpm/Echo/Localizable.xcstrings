    "onboarding_library_feature_playlists_body" : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maak playlists, kies covers en houd de nummers die je wilt bij elkaar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Create playlists, choose covers and keep the songs you want together."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Créez des playlists, choisissez leurs pochettes et regroupez les morceaux que vous aimez."
