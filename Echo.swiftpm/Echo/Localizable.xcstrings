        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Echo copie le nom et la pochette, ajoute immédiatement les morceaux existants et télécharge uniquement les morceaux manquants."
          }
        },
        "nl" : {
          "stringUnit" : {
