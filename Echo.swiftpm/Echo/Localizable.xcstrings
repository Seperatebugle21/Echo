    "onboarding_learning_subtitle" : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terwijl je luistert, verbetert Echo geleidelijk de aanbevelingen die je op Home ziet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As you listen, Echo gradually improves the recommendations shown on Home."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Au fil de vos écoutes, Echo améliore progressivement les recommandations affichées sur l’accueil."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Während du hörst, verbessert Echo nach und nach die Empfehlungen auf Home."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A medida que escuchas, Echo mejora poco a poco las recomendaciones de Inicio."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mentre ascolti, Echo migliora gradualmente i consigli mostrati nella Home."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À medida que ouves, o Echo melhora gradualmente as recomendações no Início."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podczas słuchania Echo stopniowo ulepsza polecenia na ekranie głównym."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sen dinledikçe Echo, Ana Sayfa’daki önerileri giderek iyileştirir."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "聴くほどに、Echoはホームのおすすめを少しずつ改善します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
