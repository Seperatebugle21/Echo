        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Titres, artistes, albums et pochettes permettent à chaque morceau de trouver sa place dans votre bibliothèque."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
