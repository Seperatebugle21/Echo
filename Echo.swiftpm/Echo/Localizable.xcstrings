    "audio_mono_explanation" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mono combines the left and right channels so you hear the same sound in both ears. Useful when listening with one earbud."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mono voegt het linker- en rechterkanaal samen, zodat je in beide oren hetzelfde hoort. Handig als je met één oortje luistert."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le mode mono combine les canaux gauche et droit pour diffuser le même son dans les deux oreilles. Utile si vous utilisez un seul écouteur."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mono kombiniert den linken und rechten Kanal, sodass du auf beiden Ohren denselben Ton hörst. Praktisch, wenn du nur einen Ohrhörer verwendest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mono combina los canales izquierdo y derecho para que oigas el mismo sonido en ambos oídos. Útil al escuchar con un solo auricular."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mono unisce i canali sinistro e destro così senti lo stesso suono in entrambe le orecchie. Utile quando ascolti con un solo auricolare."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mono combina os canais esquerdo e direito para ouvires o mesmo som nos dois ouvidos. Útil quando ouves com um só auricular."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mono łączy lewy i prawy kanał, dzięki czemu słyszysz ten sam dźwięk w obu uszach. Przydatne przy słuchaniu jedną słuchawką."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mono, sol ve sağ kanalları birleştirerek her iki kulakta aynı sesi duymanı sağlar. Tek kulaklıkla dinlerken kullanışlıdır."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "モノラルは左右のチャンネルをまとめ、両耳で同じ音が聞こえるようにします。片耳だけで聴くときに便利です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모노는 왼쪽과 오른쪽 채널을 합쳐 양쪽 귀에서 같은 소리를 듣게 해 줍니다. 이어폰 한쪽으로 들을 때 유용합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "单声道会合并左右声道，让两只耳朵听到相同的声音。只戴一只耳机时很实用。"
          }
        }
      }
    },
    "audio_stereo_explanation" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stereo keeps the left and right channels separate for a spatial listening experience when the recording and output device support it."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stereo houdt het linker- en rechterkanaal gescheiden voor een ruimtelijke luisterervaring wanneer de opname en het uitvoerapparaat dit ondersteunen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le mode stéréo garde les canaux gauche et droit séparés pour une écoute spatiale, si l’enregistrement et le périphérique de sortie le permettent."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stereo hält den linken und rechten Kanal getrennt und ermöglicht räumliches Hören, wenn die Aufnahme und das Ausgabegerät dies unterstützen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estéreo mantiene separados los canales izquierdo y derecho para una escucha espacial cuando la grabación y el dispositivo de salida lo admiten."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stereo mantiene separati i canali sinistro e destro per un ascolto spaziale, se la registrazione e il dispositivo di uscita lo supportano."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estéreo mantém os canais esquerdo e direito separados para uma audição espacial, quando a gravação e o dispositivo de saída o suportam."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stereo utrzymuje osobne lewy i prawy kanał dla przestrzennego brzmienia, jeśli nagranie i urządzenie wyjściowe to obsługują."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stereo, kayıt ve çıkış cihazı destekliyorsa uzamsal bir dinleme için sol ve sağ kanalları ayrı tutar."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ステレオは左右のチャンネルを分けたまま再生し、録音と出力デバイスが対応していれば広がりのある音になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스테레오는 녹음과 출력 기기가 지원하면 공간감 있는 감상을 위해 왼쪽과 오른쪽 채널을 분리해 유지합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当录音和输出设备支持时，立体声会保持左右声道分离，带来空间感。"
          }
        }
      }
    },
