    "customization_artwork_background_detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The app background becomes a soft gradient in the cover's colors, dark or light to match the appearance."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De achtergrond van de app wordt een zachte kleurovergang in de kleuren van de cover, donker of licht volgens de weergave."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fond de l’app devient un dégradé doux aux couleurs de la pochette, sombre ou clair selon l’apparence."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der App-Hintergrund wird zu einem sanften Verlauf in den Farben des Covers, dunkel oder hell passend zur Darstellung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El fondo de la app se convierte en un degradado suave con los colores de la portada, oscuro o claro según el aspecto."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo sfondo dell’app diventa una sfumatura morbida nei colori della copertina, scura o chiara in base all’aspetto."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O fundo da app torna-se um gradiente suave nas cores da capa, escuro ou claro conforme o aspeto."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tło aplikacji staje się delikatnym gradientem w kolorach okładki, ciemnym lub jasnym zależnie od wyglądu."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
