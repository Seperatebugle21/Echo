    "onboarding_library_subtitle" : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Echo houdt je nummers, playlists en favorieten samen en maakt ze makkelijk om te bekijken."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Echo keeps your songs, playlists and favourites together and makes them easy to browse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Echo réunit vos morceaux, listes de lecture et favoris pour les parcourir facilement."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Echo hält deine Songs, Playlists und Favoriten zusammen und macht sie leicht durchsuchbar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Echo reúne tus canciones, playlists y favoritos y hace que sea fácil explorarlos."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Echo tiene insieme brani, playlist e preferiti e li rende facili da sfogliare."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Echo mantém juntas as tuas músicas, playlists e favoritos e torna-os fáceis de explorar."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Echo trzyma razem utwory, playlisty i ulubione, i ułatwia ich przeglądanie."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Echo şarkılarını, çalma listelerini ve favorilerini bir arada tutar ve göz atmayı kolaylaştırır."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Echoは曲、プレイリスト、お気に入りをまとめて、見やすく管理します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Echo는 노래, 플레이리스트, 즐겨찾기를 한데 모아 쉽게 둘러볼 수 있게 해 줍니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Echo 将你的歌曲、歌单和收藏集中在一起，浏览起来轻松方便。"
          }
        }
      }
    },
