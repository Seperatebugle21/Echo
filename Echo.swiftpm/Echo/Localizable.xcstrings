    "ai_offline_detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI prompts stay on this device. Voice input also requires on-device recognition. Explicit model downloads require internet; music and podcast networking is unchanged."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI-vragen blijven op dit apparaat. Spraakinvoer vereist ook lokale herkenning. Een model downloaden vereist internet; muziek- en podcastverbindingen blijven ongewijzigd."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les requêtes d’IA restent sur cet appareil. La saisie vocale nécessite aussi la reconnaissance sur l’appareil. Le téléchargement explicite de modèles nécessite Internet ; le réseau pour la musique et les podcasts ne change pas."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KI-Anfragen bleiben auf diesem Gerät. Die Spracheingabe erfordert außerdem eine Erkennung auf dem Gerät. Ausdrückliche Modell-Downloads benötigen Internet; die Netzwerknutzung für Musik und Podcasts bleibt unverändert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las solicitudes de IA se quedan en este dispositivo. La entrada de voz también requiere reconocimiento en el dispositivo. Las descargas explícitas de modelos necesitan internet; la red para música y pódcasts no cambia."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le richieste IA restano su questo dispositivo. Anche l’input vocale richiede il riconoscimento sul dispositivo. I download espliciti dei modelli richiedono internet; la rete per musica e podcast non cambia."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os pedidos de IA ficam neste dispositivo. A entrada de voz também exige reconhecimento no dispositivo. Transferências explícitas de modelos precisam de internet; a rede para música e podcasts não muda."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapytania AI pozostają na tym urządzeniu. Wprowadzanie głosowe również wymaga rozpoznawania na urządzeniu. Jawne pobieranie modeli wymaga internetu; sieć dla muzyki i podcastów się nie zmienia."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yapay zekâ istekleri bu cihazda kalır. Sesle giriş için de cihazda tanıma gerekir. Açıkça başlatılan model indirmeleri internet gerektirir; müzik ve podcast ağ kullanımı değişmez."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AIへのリクエストはこのデバイス内で処理されます。音声入力にもデバイス上の認識が必要です。モデルを明示的にダウンロードする場合はインターネットが必要です。音楽とポッドキャストの通信は変わりません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI 요청은 이 기기에 머뭅니다. 음성 입력에도 기기 내 인식이 필요합니다. 모델을 직접 다운로드하려면 인터넷이 필요하며, 음악과 팟캐스트 네트워크 사용은 변하지 않습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI 请求保留在此设备上。语音输入也需要设备端识别。主动下载模型需要联网；音乐和播客的网络使用不受影响。"
          }
        }
      }
    },
