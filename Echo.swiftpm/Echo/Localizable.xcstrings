    "alert_cannot_be_undone_message": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je muziekbestanden en bibliotheekgegevens worden definitief verwijderd."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your music files and library data will be permanently deleted."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos fichiers musicaux et les données de votre bibliothèque seront définitivement supprimés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Musikdateien und Mediathek-Daten werden dauerhaft gelöscht."
          }
        }
      }
    },
    "alert_delete_confirmation_message": {
