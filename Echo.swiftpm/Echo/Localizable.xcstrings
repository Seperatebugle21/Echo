    "onboarding_learning_feature_listens_body" : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afgespeelde nummers, volledig beluisterde nummers, skips en favorieten helpen Echo begrijpen wat bij je past."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plays, completed songs, skips and favourites help Echo understand what fits you."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les lectures, morceaux terminés, passages et favoris aident Echo à comprendre vos goûts."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wiedergaben, vollständig gehörte Songs, Überspringen und Favoriten helfen Echo, deinen Geschmack zu verstehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reproducciones, canciones completas, saltos y favoritos ayudan a Echo a entender lo que encaja contigo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ascolti, brani completati, salti e preferiti aiutano Echo a capire cosa fa per te."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reproduções, músicas ouvidas até ao fim, saltos e favoritos ajudam o Echo a perceber o que combina contigo."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odtworzenia, dosłuchane utwory, pominięcia i ulubione pomagają Echo zrozumieć, co do Ciebie pasuje."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çalmalar, sonuna kadar dinlenen şarkılar, atlamalar ve favoriler Echo’nun sana neyin uyduğunu anlamasına yardımcı olur."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再生、最後まで聴いた曲、スキップ、お気に入りから、Echoはあなたに合う曲を理解します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "재생, 끝까지 들은 노래, 건너뛰기, 즐겨찾기를 통해 Echo가 나에게 맞는 음악을 이해합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "播放、听完的歌曲、跳过和收藏都能帮助 Echo 了解什么适合你。"
          }
        }
      }
    },
