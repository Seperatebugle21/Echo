    "equalizerview_bands_hint" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "value" : "Drag each point up or down to adjust that frequency. Left controls bass, right controls treble.",
            "state" : "translated"
          }
        },
        "nl" : {
          "stringUnit" : {
            "value" : "Sleep elk punt omhoog of omlaag om die frequentie aan te passen. Links pas je de lage tonen aan, rechts de hoge.",
            "state" : "translated"
          }
        },
        "fr" : {
          "stringUnit" : {
            "value" : "Faites glisser chaque point vers le haut ou le bas pour ajuster la fréquence. Les graves sont à gauche, les aigus à droite.",
            "state" : "translated"
          }
        },
        "de" : {
          "stringUnit" : {
            "value" : "Ziehe jeden Punkt nach oben oder unten, um die Frequenz anzupassen. Links stellst du die Bässe ein, rechts die Höhen.",
            "state" : "translated"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra cada punto hacia arriba o hacia abajo para ajustar esa frecuencia. La izquierda controla los graves y la derecha los agudos."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina ogni punto in alto o in basso per regolare quella frequenza. La sinistra controlla i bassi, la destra gli acuti."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrasta cada ponto para cima ou para baixo para ajustar essa frequência. A esquerda controla os graves e a direita os agudos."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przeciągnij każdy punkt w górę lub w dół, aby dostosować tę częstotliwość. Lewa strona to basy, prawa to soprany."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O frekansı ayarlamak için her noktayı yukarı veya aşağı sürükle. Sol bası, sağ tizi kontrol eder."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各ポイントを上下にドラッグしてその周波数を調整します。左側で低音、右側で高音を調整します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "각 지점을 위아래로 끌어 해당 주파수를 조절하세요. 왼쪽은 저음, 오른쪽은 고음을 조절합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上下拖动各个点以调整对应频率。左侧控制低音，右侧控制高音。"
          }
        }
      },
      "extractionState" : "manual"
    },
