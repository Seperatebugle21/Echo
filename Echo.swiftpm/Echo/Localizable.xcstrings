    "home_editor_add_detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap a section to add it to Home. You can add several and arrange them afterward."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik op een sectie om die toe te voegen aan Home. Je kunt er meerdere toevoegen en ze daarna ordenen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez une section pour l’ajouter à l’accueil. Ajoutez-en plusieurs et organisez-les ensuite."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf einen Bereich, um ihn hinzuzufügen. Du kannst mehrere hinzufügen und anschließend anordnen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca una sección para añadirla a Inicio. Puedes añadir varias y ordenarlas después."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca una sezione per aggiungerla alla Home. Puoi aggiungerne diverse e riordinarle dopo."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca numa secção para a adicionar ao Início. Podes adicionar várias e organizá-las depois."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stuknij sekcję, aby dodać ją do ekranu głównego. Możesz dodać kilka i ułożyć je później."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ana Sayfa’ya eklemek için bir bölüme dokun. Birkaç tane ekleyip sonra sıralayabilirsin."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "セクションをタップしてホームに追加します。複数追加して、あとで並べ替えられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "섹션을 탭하면 홈에 추가됩니다. 여러 개를 추가한 뒤 순서를 바꿀 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "轻点版块即可添加到主页。你可以添加多个，之后再调整顺序。"
          }
        }
      }
    },
