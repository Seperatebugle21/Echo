    "audio_normalization_detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plays your songs at a similar volume, whatever their source. Each song is measured once in the background; songs that are not measured yet play unchanged."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speelt je nummers even luid af, ongeacht de bron. Elk nummer wordt één keer op de achtergrond gemeten; nummers die nog niet gemeten zijn, spelen ongewijzigd af."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lit vos morceaux à un volume similaire, quelle que soit leur source. Chaque morceau est mesuré une fois en arrière-plan ; les morceaux pas encore mesurés sont lus sans changement."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spielt deine Songs unabhängig von der Quelle ähnlich laut ab. Jeder Song wird einmal im Hintergrund gemessen; noch nicht gemessene Songs werden unverändert abgespielt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reproduce tus canciones a un volumen similar, sea cual sea su origen. Cada canción se mide una vez en segundo plano; las que aún no se han medido suenan sin cambios."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riproduce i brani a un volume simile, qualunque sia la fonte. Ogni brano viene misurato una volta in background; quelli non ancora misurati suonano invariati."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reproduz as tuas músicas a um volume semelhante, seja qual for a origem. Cada música é medida uma vez em segundo plano; as que ainda não foram medidas tocam sem alterações."
          }
        }
      }
    },
