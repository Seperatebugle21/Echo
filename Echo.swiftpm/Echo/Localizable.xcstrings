            "value" : "Keşfe hâlâ yer bırakır"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しい発見の余地も"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "새로운 발견의 여지도"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仍为发现留出空间"
          }
        }
      }
    },
    "onboarding_learning_feature_discovery_body" : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aanbevelingen herhalen niet alleen je favorieten — Echo geeft ook minder beluisterde nummers een kans."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recommendations do not only repeat favourites — Echo also gives less-played songs a chance."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les recommandations ne répètent pas seulement vos favoris — Echo donne aussi une chance aux morceaux moins écoutés."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empfehlungen wiederholen nicht nur Favoriten — Echo gibt auch seltener gehörten Songs eine Chance."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las recomendaciones no solo repiten favoritos: Echo también da una oportunidad a canciones menos escuchadas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I consigli non ripetono solo i preferiti: Echo dà una possibilità anche ai brani meno ascoltati."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As recomendações não repetem só favoritos: o Echo também dá uma oportunidade a músicas menos ouvidas."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polecenia nie tylko powtarzają ulubione — Echo daje szansę również rzadziej słuchanym utworom."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öneriler yalnızca favorileri tekrarlamaz — Echo daha az dinlenen şarkılara da şans verir."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "おすすめはお気に入りの繰り返しだけではありません。Echoはあまり聴いていない曲にもチャンスを与えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "추천은 즐겨찾기만 반복하지 않습니다. Echo는 덜 들은 노래에도 기회를 줍니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "推荐不只是重复你的收藏 — Echo 也会给较少播放的歌曲机会。"
          }
        }
      }
    },
    "onboarding_fetch_title" : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haal muziek naar Echo"
          }
        },
        "en" : {
          "stringUnit" : {
