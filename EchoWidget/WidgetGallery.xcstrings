    "widget_rounded_description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Album artwork, favorites and playback controls on a colorful background."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Albumcover, favoriet en muziekbediening op een gekleurde achtergrond."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pochette, favoris et commandes de lecture sur un fond coloré."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Albumcover, Favoriten und Wiedergabesteuerung vor einem farbigen Hintergrund."
          }
        }
      }
    },
    "widget_cover_title": {
      "extractionState": "manual",
      "localizations": {
