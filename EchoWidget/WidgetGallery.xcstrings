    "widget_quick_picks_description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Quick Picks from Echo. Tap a cover to play that song."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jouw Quick Picks uit Echo. Tik op een cover om dat nummer af te spelen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre sélection rapide Echo. Touchez une pochette pour écouter le morceau."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Schnellauswahl aus Echo. Tippe auf ein Cover, um den Titel abzuspielen."
          }
        }
      }
    },
