        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een brede speler met randvullende cover en afspeelknoppen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un lecteur large avec pochette bord à bord et commandes de lecture."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein breiter Player mit randlosem Cover und Wiedergabesteuerung."
          }
        }
      }
