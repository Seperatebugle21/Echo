    "widget_compact_description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Artwork, favorites and previous, play/pause and next controls in a small widget."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cover, favoriet en vorige, pauze en volgende in een kleine widget."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pochette, favoris et commandes précédent, lecture/pause et suivant dans un petit widget."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cover, Favoriten sowie Zurück, Wiedergabe/Pause und Weiter in einem kleinen Widget."
          }
        }
      }
    },
    "widget_quick_picks_title": {
      "extractionState": "manual",
      "localizations": {
