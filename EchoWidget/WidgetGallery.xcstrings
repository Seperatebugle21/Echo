    "widget_cover_description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Large album artwork with title and artist. Tap to open Echo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een grote albumcover met titel en artiest. Tik om Echo te openen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une grande pochette avec le titre et l’artiste. Touchez pour ouvrir Echo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Großes Albumcover mit Titel und Künstler. Tippe, um Echo zu öffnen."
          }
        }
      }
    },
